# ─── Site ────────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Storage: choose ONE ─────────────────────────────────────────────────
# A) Supabase (recommended for production). Leave empty to use local JSON files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used to store public inquiries.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# B) Local JSON file store (development / single server). Directory for content, leads and uploads.
DATA_DIR=.data

# ─── Admin (local mode only — Supabase mode uses Supabase Auth + admin_users table) ──
# Generate with: npm run hash-password -- "a-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters.
SESSION_SECRET=

# ─── Email notifications (optional, via Resend) ───────────────────────────
RESEND_API_KEY=
# e.g. "Export Desk <exports@yourcompany.com>" — domain must be verified in Resend.
EMAIL_FROM=
# Where new-inquiry alerts go (defaults to the company email in the admin).
INQUIRY_NOTIFY_EMAIL=
# Optional webhook (e.g. Slack/CRM) that receives every new inquiry as JSON.
INQUIRY_WEBHOOK_URL=

# ─── Images ──────────────────────────────────────────────────────────────
# Extra HTTPS hosts next/image may optimise (comma-separated), e.g. your CDN.
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=
